# Build scratch. Every paper's LaTeX source is kept in paper-sources/, banded by rank, so the
# build tree itself is regenerable working state and is not stored: it held 35 660 files,
# including a duplicate PDF of every paper and LaTeX's .aux/.out droppings.
engine/build/
engine/build_*/
engine/papers-ranked/

# The `was`-keyed master. The same PDFs as papers/ under different names; restore_master.py
# rebuilds it exactly from papers/ and rank-map.json, verified byte for byte.
engine/papers-old-numbering/

# Downloaded OEIS b-files. A cache, refetchable, 145 MB.
engine/bcache/

# NO ZIP ARCHIVES. The papers live in papers/, one PDF per result, and nothing bundles them.
# The pattern used to name one archive; a 7.2 MB truncated zip of papers 1030-1074 sat in
# engine/ under a scrambled name for a week because it did not match. Every archive is ignored
# now, whatever it is called.
conjecture-papers-*.zip
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

*.log
*.pids
*.bak
__pycache__/

# The sweep's lock file: transient runtime state naming a live process, meaningless in a
# checkout. It exists because two sweeps writing one results file silently destroy each
# other's proved results, which happened once and left no trace but the count.
engine/*.json.lock
# Every sweep shard's working files, whatever TAG they run under. shard_* covered only the
# untagged run, so a tagged one left its transient state in the repository.
engine/shard*_hits_*.json
engine/shard*_done_*.json
engine/shard*_caps_*.json
engine/shard*_oom_*.json
engine/shard*_inflight_*.json
engine/shard_*.json

# The independent checks' per-entry progress files. Each is rewritten after every entry, so
# while a run is going the working tree is dirty every few seconds and no commit of one is
# ever current. They are progress, not results: the result is the summary each run writes
# once it has nothing left to attempt, in engine/deep-check/indep-*.json, and that is stored.
engine/indep*_done.json

# The same for the sharded check phases. Each shard rewrites its file after every entry; the
# stored result is the merge, engine/deep-check/phase5.json and phase12.json, written when a
# shard has nothing left to attempt.
engine/deep-check/phase5-*.json
engine/deep-check/phase12-*.json

# And for the order-line sweep. merge_ordwhole.py folds the shards into ordwhole_hits.json,
# which is the file the builder, the comment writer and two check phases actually read.
engine/ordwhole_hits_[0-9].json
engine/ordwhole_done_[0-9].json

# ordtails runs in shards too; its result is merged by merge_ordtails.py.
engine/ordtails_[0-9].json

# Per-shard refusal counters. These are aggregates (reason -> count) rewritten from scratch
# every few seconds by the running sweeps, so they churned the working tree continuously and
# every commit raced the next write. They are recomputable and carry nothing a later run
# needs; the refusal reasons that matter are written up in DEEP-CHECK.md and the ledger,
# where they are read.
engine/*_why.json
engine/*_why_*.json
engine/*_whyent*.json
engine/deep-check/p5-inflight-*.json

# Per-shard progress for the newer sweeps, merged into the single <stem>_hits.json and
# <stem>_done.json by src/merge_sharded.py. Same reason the order-line and tail shard files
# are ignored above: every worker rewrites its own every few seconds, so tracking them means
# the working tree is never clean and each commit races the next write.
engine/tabnew_hits_[0-9].json
engine/tabnew_done_[0-9].json
engine/rownew_hits_[0-9].json
engine/rownew_done_[0-9].json
engine/lexcf_hits_[0-9].json
engine/lexcf_done_[0-9].json
engine/mfcf_hits_[0-9].json
engine/mfcf_done_[0-9].json
engine/gfonly_hits_[0-9].json
engine/gfonly_done_[0-9].json
# the sweeps added later, same reason as the list above
engine/wordcf_hits_[0-9].json
engine/wordcf_done_[0-9].json
engine/cuspcf_hits_[0-9].json
engine/cuspcf_done_[0-9].json
engine/ecacf_hits_[0-9].json
engine/ecacf_done_[0-9].json
engine/gfdef_hits_[0-9].json
engine/gfdef_done_[0-9].json
engine/sync-hash-cache.json
# the live re-check's per-shard files; merge_live.py folds them into
# engine/deep-check/livenew.json, which IS tracked
engine/deep-check/livenew_[0-9].json
# the classes added last: second conjectures, congruences, closed-form premises
engine/snd_hits_[0-9].json
engine/snd_done_[0-9].json
engine/cong_hits_[0-9].json
engine/cong_done_[0-9].json
engine/fcf_hits_[0-9].json
engine/fcf_done_[0-9].json
engine/ca2dcf_hits_[0-9].json
engine/ca2dcf_done_[0-9].json
engine/b8cf_hits_[0-9].json
engine/b8cf_done_[0-9].json
engine/shardnp_hits_[0-9].json
engine/shardnp_done_[0-9].json
engine/shardnp_caps_[0-9].json

# `atomicjson.dump` writes .tmp-XXXXXX.json beside its target and renames it into place. The
# window is milliseconds, but with the standing sweeps writing constantly the stop hook keeps
# catching one mid-rename and reporting an untracked file. They are never meant to be tracked.
.tmp-*.json

# Shard files of the linked-a-file sweep and the rebuilt closed-form pool. Every worker
# rewrites its own every few seconds, so tracking them means the tree is never clean and
# every commit races the next write. `src/merge_sharded.py` folds them into the merged
# files, which ARE tracked.
engine/linkrec_hits_*.json
engine/linkrec_done_*.json
engine/linkrec_why*.json
engine/cfpool_hits_*.json
engine/cfpool_done_*.json
engine/cfpool_why*.json
engine/linkpoly_done.json
engine/galgood_*.json
engine/shardgal_hits_*.json
engine/shardgal_done_*.json
engine/shardgal2_hits_*.json
engine/shardgal2_done_*.json
# sweep_linkrec's TAG goes after the stem, so a TAG=cap run writes linkrec_hitscap_0.json
# and linkrec_donecap_0.json -- NOT linkreccap_hits_0.json, which is what was ignored first
# and matched nothing. Note that merge_sharded's 'linkrec' stem globs linkrec_hits_*.json and
# so does NOT pick these up: a high-cap run's hits are merged deliberately, not by default.
engine/linkrec_hits[a-z]*_*.json
engine/linkrec_done[a-z]*_*.json
engine/linkrec_why[a-z]*_*.json
engine/linkrec_whyent*.json
engine/degree_hits_*.json
engine/degree_done_*.json
engine/degree_why*.json
engine/prec_hits_*.json
engine/prec_done_*.json
engine/prec_why*.json
engine/prec_hits[a-z]*.json
engine/prec_done[a-z]*.json
engine/prec_why[a-z]*.json

# The telescoping runner's live shards. harvest.py installs from the glob zeilb-[0-9].json and
# has no merge of its own, so src/mergezeilb.py folds these into zeilb-9.json, which matches
# that glob and IS tracked. zeilb-0 and zeilb-1 are the August one-off run and stay tracked.
engine/zeilb-[3-8].json

# A one-off run -- a rebuilt pool asked once, an experiment, a measurement -- writes its hits,
# done and why files here and they are not tracked. 92 such files were committed on 15 September
# alone, which is 13 per cent of everything at the engine root in one day, and the root is
# tracked because a container restart wipes it. Only a STANDING sweep's state belongs in git.
engine/scratch/
